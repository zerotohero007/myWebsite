<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#102a43">
  <meta name="color-scheme" content="light">
  <title>浙能技术研究院专家费计算器</title>
  <style>
    :root {
      --scale: 1;
      --ink: #102a43;
      --muted: #65798b;
      --line: #dbe4eb;
      --soft: #f2f6f9;
      --paper: #ffffff;
      --accent: #147a9b;
      --accent-dark: #0e5f7c;
      --danger: #b92e3b;
      font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", "Helvetica Neue", Arial, sans-serif;
      font-size: calc(16px * var(--scale));
      color: var(--ink);
      background: #eef3f6;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; }
    button, input { font: inherit; }
    button { cursor: pointer; }
    a { color: inherit; }
    .shell { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
    .topbar { background: var(--ink); color: #fff; position: relative; overflow: hidden; }
    .topbar::after {
      content: ""; position: absolute; width: 28rem; height: 28rem; right: -8rem; top: -19rem;
      border: 1px solid rgba(255,255,255,.12); border-radius: 50%; box-shadow: 0 0 0 4rem rgba(255,255,255,.025), 0 0 0 8rem rgba(255,255,255,.018);
      pointer-events: none;
    }
    .top-inner, .main-inner, .footer-inner { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
    .top-inner { min-height: 112px; display: flex; align-items: center; justify-content: space-between; gap: 24px; position: relative; z-index: 1; }
    .brand { display: flex; align-items: center; gap: 17px; min-width: 0; }
    .brand-mark { width: 68px; height: 68px; flex: 0 0 auto; padding: 5px; border-radius: 13px; background: #fff; object-fit: contain; }
    .brand-copy { min-width: 0; }
    .brand-org { margin: 0 0 5px; color: #b9d1df; font-size: .78rem; letter-spacing: .13em; font-weight: 600; }
    h1 { margin: 0; font-size: clamp(1.32rem, 2.4vw, 1.75rem); letter-spacing: .025em; font-weight: 700; line-height: 1.25; }
    .font-tools { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
    .font-label { font-size: .8rem; color: #b9d1df; }
    .segmented { display: inline-flex; padding: 3px; gap: 2px; border: 1px solid rgba(255,255,255,.23); border-radius: 10px; background: rgba(255,255,255,.07); }
    .font-button { min-width: 42px; min-height: 38px; padding: 0 10px; border: 0; border-radius: 7px; background: transparent; color: #d4e4ed; font-size: .85rem; font-weight: 600; }
    .font-button[aria-pressed="true"] { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
    .font-button:focus-visible, .clear-button:focus-visible, .guide-link:focus-visible, .amount-input:focus-visible { outline: 3px solid #5dc5df; outline-offset: 3px; }
    main { flex: 1; }
    .main-inner { padding: 40px 0 48px; }
    .intro { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 23px; }
    .eyebrow { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 9px; color: var(--accent-dark); font-size: .77rem; font-weight: 700; letter-spacing: .13em; }
    .eyebrow::before { content: ""; width: 19px; height: 2px; background: var(--accent); }
    h2 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.1rem); line-height: 1.3; letter-spacing: -.02em; }
    .intro-note { margin: 0 0 3px; color: var(--muted); line-height: 1.6; font-size: .87rem; text-align: right; }
    .mode-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; width: min(100%, 650px); padding: 5px; margin: 0 0 18px; border: 1px solid var(--line); border-radius: 13px; background: #e5edf2; }
    .mode-tab { min-height: 45px; padding: 9px 12px; border: 0; border-radius: 9px; background: transparent; color: #536d80; font-size: .86rem; font-weight: 700; line-height: 1.4; }
    .mode-tab[aria-selected="true"] { background: #fff; color: var(--ink); box-shadow: 0 2px 7px rgba(16,42,67,.1); }
    .mode-tab:focus-visible { outline: 3px solid #5dc5df; outline-offset: 2px; }
    .calculator { display: grid; grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr); gap: 20px; align-items: stretch; }
    .panel { background: var(--paper); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 14px 34px rgba(16,42,67,.055); }
    .entry-panel { padding: 30px; display: flex; flex-direction: column; }
    .section-kicker { color: var(--accent-dark); font-weight: 700; font-size: .77rem; letter-spacing: .1em; margin-bottom: 14px; }
    .field-label { display: block; font-size: .95rem; font-weight: 700; margin-bottom: 11px; }
    .amount-wrap { display: flex; align-items: center; min-height: 86px; border: 1.5px solid #b7cbd7; border-radius: 14px; background: #fbfdfe; padding: 0 20px; transition: border-color .18s, box-shadow .18s; }
    .amount-wrap:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px rgba(20,122,155,.11); }
    .amount-wrap.invalid { border-color: var(--danger); box-shadow: 0 0 0 4px rgba(185,46,59,.09); }
    .currency { font-size: 1.75rem; font-weight: 600; color: var(--accent-dark); margin-right: 13px; }
    .amount-input { min-width: 0; width: 100%; padding: 15px 0; border: 0; outline: none; background: transparent; color: var(--ink); font-size: clamp(1.7rem, 4vw, 2.45rem); font-weight: 700; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
    .amount-input::placeholder { color: #aab9c4; }
    .field-help { min-height: 1.5em; margin: 11px 0 0; color: var(--muted); font-size: .81rem; line-height: 1.5; }
    .field-help.error { color: var(--danger); }
    .entry-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 26px 0 20px; }
    .live-note { color: var(--muted); font-size: .8rem; }
    .live-dot { display: inline-block; width: 7px; height: 7px; margin-right: 6px; border-radius: 50%; background: var(--accent); vertical-align: 1px; }
    .clear-button { border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--ink); padding: 8px 13px; font-size: .78rem; font-weight: 600; min-height: 38px; }
    .clear-button:hover { background: var(--soft); }
    .invoice { margin-top: auto; padding: 25px 27px 26px; background: var(--ink); border-radius: 15px; color: #fff; position: relative; overflow: hidden; }
    .invoice::before { content: ""; position: absolute; right: -60px; bottom: -138px; width: 260px; height: 260px; border: 1px solid rgba(255,255,255,.11); border-radius: 50%; box-shadow: 0 0 0 36px rgba(255,255,255,.025), 0 0 0 72px rgba(255,255,255,.018); }
    .invoice-label { margin: 0 0 4px; color: #c4d8e3; font-size: .85rem; font-weight: 600; position: relative; }
    .invoice-subtitle { margin: 0; color: #8eb3c5; font-size: .75rem; position: relative; }
    .invoice-amount { display: block; margin-top: 22px; font-size: clamp(2.4rem, 5vw, 3.55rem); font-weight: 750; line-height: 1.12; letter-spacing: -.05em; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; position: relative; }
    .invoice-amount .unit { font-size: .34em; font-weight: 500; letter-spacing: 0; margin-left: 7px; color: #bcd5df; }
    .reconcile-note { min-height: 2.4em; margin: 12px 2px 0; color: var(--muted); font-size: .76rem; line-height: 1.55; }
    .reconcile-note:not([hidden]).approximate { color: #9a5b19; }
    .detail-panel { padding: 29px 29px 22px; }
    .detail-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 16px; }
    .detail-title { margin: 0; font-size: 1.13rem; font-weight: 700; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .metric { min-width: 0; border: 1px solid #e5ebf0; border-radius: 11px; background: #f6f8fa; padding: 15px 15px 14px; }
    .metric-label { display: block; color: #637688; font-size: .78rem; margin-bottom: 11px; line-height: 1.35; }
    .metric output { display: block; text-align: right; color: #40556a; font-size: clamp(1.12rem, 2.1vw, 1.38rem); font-weight: 650; line-height: 1.2; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .metric .unit { color: #8091a0; font-size: .7em; margin-left: 3px; font-weight: 400; }
    .detail-foot { border-top: 1px solid var(--line); margin-top: 19px; padding-top: 15px; color: var(--muted); font-size: .75rem; line-height: 1.7; }
    .detail-foot ul { margin: 0; padding-left: 1.35em; }
    .detail-foot li + li { margin-top: 5px; }
    .guide-section { margin-top: 28px; border-top: 1px solid #cbd9e2; padding-top: 27px; }
    .guide-head { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 16px; }
    .guide-head h2 { font-size: 1.12rem; letter-spacing: 0; }
    .guide-head p { margin: 0; color: var(--muted); font-size: .79rem; line-height: 1.5; text-align: right; }
    .guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .guide-link, .guide-placeholder { min-height: 92px; display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 20px 22px; border: 1px solid var(--line); border-radius: 13px; background: #fff; text-decoration: none; }
    .guide-link:hover { border-color: #9ec6d5; background: #f9fcfd; }
    .guide-placeholder { background: rgba(255,255,255,.5); border-style: dashed; }
    .guide-title { display: block; font-size: .9rem; font-weight: 700; margin-bottom: 5px; }
    .guide-desc { display: block; color: var(--muted); font-size: .76rem; line-height: 1.4; }
    .guide-arrow { color: var(--accent); font-size: 1.35rem; line-height: 1; flex: 0 0 auto; }
    .guide-placeholder .guide-arrow { color: #9fb0bc; }
    footer { border-top: 1px solid #d8e2e9; }
    .footer-inner { padding: 19px 0 23px; color: #8293a1; text-align: center; font-size: .7rem; }
    @media (max-width: 800px) {
      .top-inner, .main-inner, .footer-inner { width: min(100% - 32px, 650px); }
      .top-inner { min-height: 100px; }
      .main-inner { padding-top: 28px; }
      .calculator { grid-template-columns: 1fr; }
      .entry-panel { min-height: 420px; }
      .intro-note { display: none; }
    }
    @media (max-width: 520px) {
      .top-inner { min-height: 115px; align-items: flex-start; padding-top: 20px; padding-bottom: 16px; flex-direction: column; gap: 14px; }
      .brand-mark { width: 51px; height: 51px; border-radius: 9px; padding: 3px; }
      .brand { gap: 11px; }
      .brand-org { font-size: .68rem; margin-bottom: 3px; }
      h1 { font-size: 1.22rem; }
      .font-tools { align-self: flex-end; }
      .font-button { min-width: 39px; min-height: 33px; }
      .main-inner { padding-top: 25px; padding-bottom: 32px; }
      .entry-panel, .detail-panel { padding: 22px 19px; }
      .entry-panel { min-height: 0; }
      .amount-wrap { min-height: 76px; padding: 0 15px; }
      .invoice { margin-top: 3px; padding: 22px 20px; }
      .detail-grid { gap: 8px; }
      .metric { padding: 13px 11px; }
      .metric-label { min-height: 2.15em; font-size: .72rem; margin-bottom: 8px; }
      .metric output { font-size: 1.08rem; }
      .guide-head { display: block; }
      .guide-head p { margin-top: 5px; text-align: left; }
      .guide-grid { grid-template-columns: 1fr; }
      .mode-tab { min-height: 54px; padding: 8px 7px; font-size: .79rem; }
    }
    @media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; transition: none !important; } }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div class="top-inner">
        <div class="brand">
          <img class="brand-mark" src="data:image/png;base64," alt="浙能标识" width="68" height="68">
          <div class="brand-copy">
            <p class="brand-org">浙能技术研究院</p>
            <h1>专家费计算器</h1>
          </div>
        </div>
        <div class="font-tools" role="group" aria-label="界面字号">
          <span class="font-label">字体大小</span>
          <div class="segmented">
            <button class="font-button" type="button" data-size="small" aria-pressed="false">小</button>
            <button class="font-button" type="button" data-size="medium" aria-pressed="true">中</button>
            <button class="font-button" type="button" data-size="large" aria-pressed="false">大</button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="main-inner">
        <div class="intro">
          <div>
            <p class="eyebrow">EXPERT FEE ESTIMATE</p>
            <h2 id="intro-title">输入实发金额，查看开票金额</h2>
          </div>
          <p class="intro-note">劳务报酬税费试算<br>金额单位：人民币元</p>
        </div>

        <div class="mode-tabs" role="tablist" aria-label="计算方式">
          <button class="mode-tab" id="tab-net" type="button" role="tab" aria-selected="true" aria-controls="calc-panel" data-mode="net">实发数计算开票金额</button>
          <button class="mode-tab" id="tab-invoice" type="button" role="tab" aria-selected="false" aria-controls="calc-panel" data-mode="invoice">开票金额计算实发数</button>
        </div>
        <div class="calculator" id="calc-panel" role="tabpanel" aria-labelledby="tab-net">
          <section class="panel entry-panel" aria-labelledby="input-title">
            <div class="section-kicker">01 / 金额输入</div>
            <label class="field-label" id="input-title" for="amount-input">实发金额</label>
            <div class="amount-wrap" id="amount-wrap">
              <span class="currency" aria-hidden="true">¥</span>
              <input class="amount-input" id="amount-input" type="text" inputmode="decimal" autocomplete="off" enterkeyhint="done" value="2000" aria-describedby="field-help" aria-invalid="false">
            </div>
            <p class="field-help" id="field-help">已填入 2,000 元示例，可直接修改。</p>
            <div class="entry-actions">
              <span class="live-note"><span class="live-dot" aria-hidden="true"></span>输入后实时计算</span>
              <button class="clear-button" id="clear-button" type="button">清空金额</button>
            </div>
            <div class="invoice" aria-live="polite" aria-atomic="true">
              <p class="invoice-label" id="primary-label">最终开票金额</p>
              <p class="invoice-subtitle" id="primary-subtitle">含税销售额</p>
              <output class="invoice-amount" id="primary-amount" for="amount-input">2,323.82<span class="unit">元</span></output>
            </div>
            <p class="reconcile-note" id="reconcile-note" aria-live="polite" hidden></p>
          </section>

          <section class="panel detail-panel" aria-labelledby="detail-title">
            <div class="section-kicker">02 / 税费明细</div>
            <div class="detail-title-row">
              <h2 class="detail-title" id="detail-title">自动计算结果</h2>
            </div>
            <div class="detail-grid">
              <div class="metric"><span class="metric-label">应发不含增值税金额</span><output id="before-vat" for="amount-input">2,300.81<span class="unit">元</span></output></div>
              <div class="metric"><span class="metric-label">增值税</span><output id="vat" for="amount-input">23.01<span class="unit">元</span></output></div>
              <div class="metric"><span class="metric-label">城建税</span><output id="city-tax" for="amount-input">0.81<span class="unit">元</span></output></div>
              <div class="metric"><span class="metric-label">个人所得税</span><output id="income-tax" for="amount-input">300.00<span class="unit">元</span></output></div>
              <div class="metric"><span class="metric-label">个税缴纳基数</span><output id="tax-report" for="amount-input">2,300.00<span class="unit">元</span></output></div>
              <div class="metric"><span class="metric-label">其他应付款金额</span><output id="other-payable" for="amount-input">2,023.82<span class="unit">元</span></output></div>
            </div>
            <div class="detail-foot">
              <ul>
                <li>应发不含增值税金额未满 1,000 元时，增值税及城建税均为 0；达到 1,000 元时按原税率计算。</li>
                <li>个税规则不变，各项金额四舍五入到分。</li>
                <li>本页按单次试算，同日多次交易应合并判断起征点。</li>
              </ul>
            </div>
          </section>
        </div>

        <section class="guide-section" aria-labelledby="guide-title">
          <div class="guide-head">
            <h2 id="guide-title">操作指引</h2>
            <p>相关材料可在此集中查看，后续可继续添加链接。</p>
          </div>
          <div class="guide-grid">
            <a class="guide-link" href="#" id="guide-pdf-link" target="_blank" rel="noopener" download="20260731 专家费报销操作指引（2026年最新版）.pdf">
              <span><span class="guide-title">专家费报销操作指引</span><span class="guide-desc">下载内置的 2026 年最新版 PDF</span></span>
              <span class="guide-arrow" aria-hidden="true">↗</span>
            </a>
            <div class="guide-placeholder" aria-label="专家操作指引预留位置">
              <span><span class="guide-title">专家操作指引</span><span class="guide-desc">预留位置 · 可按需接入文件或网页</span></span>
              <span class="guide-arrow" aria-hidden="true">＋</span>
            </div>
          </div>
        </section>
      </div>
    </main>
    <footer><div class="footer-inner">©2026 浙能技术研究院 财务部</div></footer>
  </div>

  <script id="guide-pdf-data" type="application/octet-stream"></script>
  <script>
    (function () {
      'use strict';
      var amountInput = document.getElementById('amount-input');
      var amountWrap = document.getElementById('amount-wrap');
      var help = document.getElementById('field-help');
      var reconcileNote = document.getElementById('reconcile-note');
      var mode = 'net';
      var lastModel = null;
      var fields = {
        primary: document.getElementById('primary-amount'),
        beforeVat: document.getElementById('before-vat'),
        vat: document.getElementById('vat'),
        city: document.getElementById('city-tax'),
        incomeTax: document.getElementById('income-tax'),
        report: document.getElementById('tax-report'),
        payable: document.getElementById('other-payable')
      };
      var numberFormat = new Intl.NumberFormat('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      function round(value, digits) {
        var factor = Math.pow(10, digits);
        return Math.round((value + Number.EPSILON * Math.max(1, Math.abs(value))) * factor) / factor;
      }
      function calculate(net) {
        var pit;
        if (net <= 800) pit = 0;
        else if (net <= 3360) pit = round((net * 0.2 - 160) / 0.8, 2);
        else if (net <= 21000) pit = round(net * 0.16 / 0.84, 2);
        else if (net <= 49500) pit = round((net * 0.24 - 2000) / 0.76, 2);
        else pit = round((net * 0.32 - 7000) / 0.68, 2);

        var report = round(net + pit, 2);
        var beforeVat = report;
        var vat = 0;
        var city = 0;
        var nextCity;
        if (report >= 1000) {
          city = round(round(report / (1 - 0.01 * 0.07 * 0.5) * 0.01, 2) * 0.07 * 0.5, 2);
          for (var i = 0; i < 8; i++) {
            beforeVat = round(report + city, 2);
            vat = round(beforeVat * 0.01, 2);
            nextCity = round(vat * 0.07 * 0.5, 2);
            if (nextCity === city) break;
            city = nextCity;
          }
          beforeVat = round(report + city, 2);
          vat = round(beforeVat * 0.01, 2);
        }
        return {
          invoice: round(beforeVat + vat, 2), beforeVat: beforeVat, vat: vat,
          city: city, incomeTax: pit, report: report,
          payable: round(net + vat + city, 2)
        };
      }
      function calculateFromInvoice(invoice) {
        var targetCents = Math.round(invoice * 100);
        var low = 0;
        var high = targetCents;
        while (low < high) {
          var middle = Math.floor((low + high) / 2);
          var middleInvoice = Math.round(calculate(middle / 100).invoice * 100);
          if (middleInvoice < targetCents) low = middle + 1;
          else high = middle;
        }
        var candidates = [low, Math.max(0, low - 1)];
        var bestCents = candidates[0];
        var bestResult = calculate(bestCents / 100);
        var bestDifference = Math.round(bestResult.invoice * 100) - targetCents;
        for (var index = 1; index < candidates.length; index++) {
          var candidateResult = calculate(candidates[index] / 100);
          var difference = Math.round(candidateResult.invoice * 100) - targetCents;
          if (Math.abs(difference) < Math.abs(bestDifference) ||
              (Math.abs(difference) === Math.abs(bestDifference) && candidates[index] < bestCents)) {
            bestCents = candidates[index];
            bestResult = candidateResult;
            bestDifference = difference;
          }
        }
        return { net: bestCents / 100, result: bestResult, differenceCents: bestDifference };
      }
      function showValue(node, value) {
        node.textContent = '';
        if (value === null) {
          node.textContent = '—';
        } else {
          node.appendChild(document.createTextNode(numberFormat.format(value)));
          var unit = document.createElement('span');
          unit.className = 'unit';
          unit.textContent = '元';
          node.appendChild(unit);
        }
      }
      function render() {
        var raw = amountInput.value.replace(/,/g, '').trim();
        var valid = /^\d+(?:\.\d{0,2})?$/.test(raw) && Number(raw) <= 999999999.99;
        var empty = raw === '';
        var inputAmount = valid ? Number(raw) : null;
        var inverse = valid && mode === 'invoice' ? calculateFromInvoice(inputAmount) : null;
        var result = valid ? (inverse ? inverse.result : calculate(inputAmount)) : null;
        var primary = result ? (mode === 'net' ? result.invoice : inverse.net) : null;
        showValue(fields.primary, primary);
        ['beforeVat', 'vat', 'city', 'incomeTax', 'report', 'payable'].forEach(function (key) {
          showValue(fields[key], result ? result[key] : null);
        });
        lastModel = result ? { net: mode === 'net' ? inputAmount : inverse.net, invoice: result.invoice } : null;
        amountWrap.classList.toggle('invalid', !empty && !valid);
        amountInput.setAttribute('aria-invalid', String(!empty && !valid));
        help.classList.toggle('error', !empty && !valid);
        help.textContent = empty ? (mode === 'net' ? '请输入专家实际到手金额，结果将实时显示。' : '请输入含税开票金额，结果将实时显示。')
          : valid ? '按当前税费口径自动试算；灰色明细不可编辑。'
          : '请输入 0 至 999,999,999.99 元，最多保留两位小数。';
        reconcileNote.hidden = !inverse;
        reconcileNote.classList.toggle('approximate', Boolean(inverse && inverse.differenceCents));
        if (inverse) {
          reconcileNote.textContent = inverse.differenceCents === 0
            ? '正算核对：实发 ' + numberFormat.format(inverse.net) + ' 元 → 开票 ' + numberFormat.format(result.invoice) + ' 元，与输入一致。'
            : '按分取整后，该开票金额无法精确反推；最接近可开票金额为 ' + numberFormat.format(result.invoice) + ' 元，差额 ' + numberFormat.format(Math.abs(inverse.differenceCents) / 100) + ' 元。';
        } else {
          reconcileNote.textContent = '';
        }
      }
      function setMode(nextMode) {
        if (nextMode === mode) return;
        var transferred = lastModel ? (nextMode === 'invoice' ? lastModel.invoice : lastModel.net) : null;
        mode = nextMode;
        amountInput.value = transferred === null ? '' : transferred.toFixed(2);
        document.getElementById('input-title').textContent = mode === 'net' ? '实发金额' : '开票金额（含税销售额）';
        document.getElementById('intro-title').textContent = mode === 'net' ? '输入实发金额，查看开票金额' : '输入开票金额，反算实发金额';
        document.getElementById('primary-label').textContent = mode === 'net' ? '最终开票金额' : '预计实发金额';
        document.getElementById('primary-subtitle').textContent = mode === 'net' ? '含税销售额' : '按分反推并正算核对';
        Array.prototype.forEach.call(document.querySelectorAll('.mode-tab'), function (button) {
          button.setAttribute('aria-selected', String(button.getAttribute('data-mode') === mode));
        });
        document.getElementById('calc-panel').setAttribute('aria-labelledby', mode === 'net' ? 'tab-net' : 'tab-invoice');
        render();
      }
      Array.prototype.forEach.call(document.querySelectorAll('.mode-tab'), function (button) {
        button.addEventListener('click', function () { setMode(button.getAttribute('data-mode')); });
        button.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
            event.preventDefault();
            var next = button.getAttribute('data-mode') === 'net' ? 'invoice' : 'net';
            setMode(next);
            document.getElementById(next === 'net' ? 'tab-net' : 'tab-invoice').focus();
          }
        });
      });
      amountInput.addEventListener('input', render);
      document.getElementById('clear-button').addEventListener('click', function () {
        amountInput.value = '';
        render();
        amountInput.focus();
      });
      var guideLink = document.getElementById('guide-pdf-link');
      guideLink.addEventListener('click', function () {
        if (!guideLink.getAttribute('data-ready')) {
          var binary = atob(document.getElementById('guide-pdf-data').textContent.trim());
          var chunks = [];
          for (var offset = 0; offset < binary.length; offset += 8192) {
            var part = binary.slice(offset, offset + 8192);
            var bytes = new Uint8Array(part.length);
            for (var index = 0; index < part.length; index++) bytes[index] = part.charCodeAt(index);
            chunks.push(bytes);
          }
          guideLink.href = URL.createObjectURL(new Blob(chunks, { type: 'application/pdf' }));
          guideLink.setAttribute('data-ready', 'true');
        }
      });
      var sizeMap = { small: 0.92, medium: 1, large: 1.12 };
      function setSize(size) {
        if (!Object.prototype.hasOwnProperty.call(sizeMap, size)) size = 'medium';
        document.documentElement.style.setProperty('--scale', sizeMap[size]);
        Array.prototype.forEach.call(document.querySelectorAll('.font-button'), function (button) {
          button.setAttribute('aria-pressed', String(button.getAttribute('data-size') === size));
        });
        try { localStorage.setItem('zn-expert-fee-font-size', size); } catch (error) { /* local files may block storage */ }
      }
      Array.prototype.forEach.call(document.querySelectorAll('.font-button'), function (button) {
        button.addEventListener('click', function () { setSize(button.getAttribute('data-size')); });
      });
      var savedSize = 'medium';
      try { savedSize = localStorage.getItem('zn-expert-fee-font-size') || 'medium'; } catch (error) { /* use default */ }
      setSize(savedSize);
      render();
    }());
  </script>
</body>
</html>
